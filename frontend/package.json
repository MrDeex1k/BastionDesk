    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react-doctor": "^0.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12"
