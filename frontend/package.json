{
  "name": "bastiondesk-frontend",
  "version": "1.0.3",
  "description": "BastionDesk frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && bunx --bun vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "preview": "bunx --bun vite preview",
    "doctor": "react-doctor . --verbose --scope changed",
    "test": "bun test",
    "test:components": "bun test ./tests/component",
    "test:order": "bun test --randomize --seed 42 && bun test --randomize --seed 1337",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:report": "bun scripts/public-e2e-report.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/passkey": "1.7.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.1.1",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "nanostores": "1.5.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "react-doctor": "0.9.14",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
