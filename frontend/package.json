{
  "name": "bastiondesk-frontend",
  "version": "1.0.3",
  "description": "BastionDesk frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && bunx --bun vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "preview": "bunx --bun vite preview",
    "doctor": "react-doctor . --verbose --scope changed"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/passkey": "1.7.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@tanstack/router-plugin": "1.168.35",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
