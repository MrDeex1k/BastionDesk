    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@better-auth/passkey": "^1.6.10",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "better-auth": "^1.6.10",
    "class-variance-authority": "^0.7.1",
