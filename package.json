{
  "name": "bastiondesk",
  "version": "1.0.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck format",
    "changelog:generate": "conventional-changelog -n changelog.config.mjs -i CHANGELOG.md -s -r 1",
    "commitlint": "commitlint",
    "deps:install": "sfw bun install --minimum-release-age 86400",
    "deps:update": "sfw bun update --latest --minimum-release-age 86400",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "husky": "9.1.7",
    "sfw": "2.0.6",
    "turbo": "2.10.12"
  }
}
