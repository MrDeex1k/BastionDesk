# BastionDesk environment template
# Copy this file to .env for local Docker Compose development.
# Never put real production secrets in this file.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3333

# Frontend
FRONTEND_URL=http://localhost:4567
VITE_API_URL=http://localhost:3333

# -----------------------------------------------------------------------------
# PostgreSQL / PgBouncer
# -----------------------------------------------------------------------------
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=bastiondesk_superadmin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=bastiondesk

PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
DATABASE_URL=postgresql://bastiondesk_superadmin:change-me-postgres-password@pgbouncer:6432/bastiondesk?sslmode=require

DB_TLS_CA_PATH=/certs/ca/ca.crt
DB_TLS_CERT_PATH=/certs/backend/client.crt
DB_TLS_KEY_PATH=/certs/backend/client.key

# -----------------------------------------------------------------------------
# Better Auth / WebAuthn
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3333
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4567,http://localhost:3333

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BastionDesk
WEBAUTHN_ORIGIN=http://localhost:4567

CORS_ORIGIN=http://localhost:4567

# -----------------------------------------------------------------------------
# LLM service
# -----------------------------------------------------------------------------
LLM_GRPC_TARGET=llm_service:8443
LLM_TLS_CA_PATH=/certs/ca/ca.crt
LLM_TLS_CERT_PATH=/certs/backend/client.crt
LLM_TLS_KEY_PATH=/certs/backend/client.key
LLM_RPC_TIMEOUT_MS=30000

# Optional: required only when the selected Hugging Face model needs auth.
HF_TOKEN=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# MinIO / S3
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=bastiondesk_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-root-password

S3_ENDPOINT=https://storage-1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bastiondesk_minio_admin
S3_SECRET_KEY=change-me-minio-root-password
S3_BUCKET=bastiondesk
S3_TLS_CA_PATH=/certs/ca/ca.crt

# -----------------------------------------------------------------------------
# PostgreSQL backups
# -----------------------------------------------------------------------------
BACKUP_CRON=0 3 * * *
BACKUP_RUN_ON_START=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_PREFIX=postgres/daily
BACKUP_MAX_AGE_SECONDS=129600

# -----------------------------------------------------------------------------
# SMTP / Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_APP_PASSWORD=change-me-smtp-app-password
EMAIL_FROM_NAME=BastionDesk
EMAIL_FROM_ADDRESS=notifications@example.com
