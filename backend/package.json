{
  "name": "bastiondesk-backend",
  "version": "0.9.0",
  "description": "BastionDesk backend with Better-Auth",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --apply src/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.4.17",
    "better-auth": "^1.4.17",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.17.2",
    "uuidv7": "^1.1.0",
    "zod": "^4.3.6"
  }
}
