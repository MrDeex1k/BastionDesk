{
	"name": "bastiondesk-backend",
	"version": "1.0.3",
	"description": "BastionDesk backend with Better-Auth",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"test:baseline": "bun run test:baseline:contract && bun run test:baseline:tenant && bun run test:baseline:workflow",
		"test:baseline:contract": "bun test src/routes/admin/query-schemas.test.ts src/utils/file.helper.test.ts src/utils/validation.test.ts src/lib/llm-client.test.ts",
		"test:baseline:tenant": "bun test src/lib/organization-helpers-plugin.test.ts src/routes/shared/middleware.test.ts src/routes/admin/query-execution.test.ts",
		"test:baseline:workflow": "bun test src/routes/analyst/upload-validation.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware src/",
		"lint:fix": "oxlint --type-aware --fix src/",
		"format": "oxfmt --check src/",
		"format:fix": "oxfmt --write src/",
		"start:auth": "bun run src/auth/main.ts"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/helmet": "4.0.0",
		"@types/pg": "8.23.1",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.18",
		"@grpc/grpc-js": "1.14.7",
		"@grpc/proto-loader": "0.8.1",
		"@nestjs/common": "12.4.2",
		"@nestjs/core": "12.4.2",
		"@nestjs/platform-express": "12.4.2",
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
		"@opentelemetry/exporter-trace-otlp-http": "0.301.1",
		"@opentelemetry/sdk-metrics": "3.1.1",
		"@opentelemetry/sdk-node": "0.301.1",
		"amqplib": "2.3.1",
		"better-auth": "1.7.18",
		"cors": "2.8.6",
		"dotenv": "18.0.10",
		"effect": "4.1.2",
		"elysia": "2.0.0-rc.4",
		"express": "5.3.0",
		"express-rate-limit": "8.7.3",
		"helmet": "8.3.0",
		"jose": "6.2.16",
		"nodemailer": "10.4.0",
		"pg": "8.23.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"zod": "4.6.7"
	}
}
