{
	"name": "bastiondesk-backend",
	"version": "1.0.3",
	"description": "BastionDesk backend with Better-Auth",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware src/",
		"lint:fix": "oxlint --type-aware --fix src/",
		"format": "oxfmt --check src/",
		"format:fix": "oxfmt --write src/"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/helmet": "4.0.0",
		"@types/nodemailer": "8.0.1",
		"@types/pg": "8.23.1",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@grpc/grpc-js": "1.14.4",
		"@grpc/proto-loader": "0.8.1",
		"@better-auth/passkey": "1.7.2",
		"better-auth": "1.7.2",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"express-rate-limit": "8.6.2",
		"helmet": "8.3.0",
		"nodemailer": "9.0.6",
		"pg": "8.23.0",
		"uuidv7": "1.2.1",
		"zod": "4.4.3"
	}
}
