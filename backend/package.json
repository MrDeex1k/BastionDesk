{
  "name": "bastiondesk-backend",
  "version": "1.0.2",
  "description": "BastionDesk backend with Better-Auth",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/",
    "lint:fix": "oxlint --type-aware --fix src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt --write src/",
    "deps:install": "bun install --minimum-release-age 172800",
    "deps:update": "bun update --latest --minimum-release-age 172800"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/helmet": "4.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@better-auth/passkey": "1.6.23",
    "better-auth": "1.6.23",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.3.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "uuidv7": "1.2.1",
    "zod": "4.4.3"
  }
}
