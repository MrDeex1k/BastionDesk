{
  "name": "bastiondesk-backend",
  "version": "1.0.0",
  "description": "BastionDesk backend with Better-Auth",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --write src/",
    "deps:install": "bun install --minimum-release-age 216000",
    "deps:update": "bun update --latest --minimum-release-age 216000"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@better-auth/passkey": "^1.6.10",
    "better-auth": "^1.6.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  }
}
